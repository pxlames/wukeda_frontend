# 环境变量示例文件
# 复制此文件为 .env.local 并修改配置

# 后端 API 地址
VITE_API_BASE_URL=http://localhost:8120

# 实验室简介页默认图片（房间目录没有 1/2 图片时使用）
VITE_LAB_INTRO_FALLBACK_IMAGE_LEFT=https://c.animaapp.com/mlffd3qha1Fp36/img/rectangle-2346.png
VITE_LAB_INTRO_FALLBACK_IMAGE_RIGHT=https://c.animaapp.com/mlffd3qha1Fp36/img/rectangle-2347.png

# 设备看板 /device-dashboard 数据刷新间隔（毫秒），不设置则默认 1000（1 秒）
# VITE_DEVICE_DASHBOARD_REFRESH_INTERVAL=1000

