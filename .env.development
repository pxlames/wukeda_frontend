# 当前 dev 环境：前端 8020，后端 8024
# 开发环境固定走同源 /api（由 Vite 代理转发），这里必须留空
VITE_API_BASE_URL=




# 仅当 VITE_API_BASE_URL 为空时生效
# VITE_PROXY_TARGET=http://47.117.105.21:8225
VITE_PROXY_TARGET=http://localhost:8224
# 全部开启 mock（数据为空时用 mock；不设或 false = 走真实接口）
VITE_ENERGY_MOCK=false
VITE_ENV_MOCK=false
VITE_EXHAUST_MOCK=false
VITE_HISTORY_MOCK=false

# 设备看板 /device-dashboard 数据刷新间隔（毫秒），1 秒 = 1000
VITE_DEVICE_DASHBOARD_REFRESH_INTERVAL=1000

