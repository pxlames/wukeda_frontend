# 当前 dev 环境：前端隧道 8020→本地5174，后端隧道 8022→本地8080（8021 被占用时可改用 8022）
# 访问地址：http://47.117.105.21:8020（前端） | API：http://47.117.105.21:8022（后端）
VITE_API_BASE_URL=http://47.117.105.21:8024
# VITE_API_BASE_URL=http://47.117.105.21:8224
# 仅当 VITE_API_BASE_URL 为空时生效（本地开 localhost:5174 且后端在 127.0.0.1:8080 时）
VITE_PROXY_TARGET=http://127.0.0.1:8080
# 全部开启 mock（数据为空时用 mock；不设或 false = 走真实接口）
VITE_ENERGY_MOCK=true
VITE_ENV_MOCK=true
VITE_EXHAUST_MOCK=true
VITE_HISTORY_MOCK=true

